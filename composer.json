{
    "name": "alexandrebulete/ddd-symfony-bundle",
    "description": "Symfony Bundle for DDD Foundation - Messenger Command/Query Bus integration",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexandre Bulete"
        }
    ],
    "require": {
        "php": "^8.2",
        "alexandrebulete/ddd-foundation": "^1.4",
        "symfony/framework-bundle": "^7.0 || ^8.0",
        "symfony/messenger": "^7.0 || ^8.0",
        "symfony/dependency-injection": "^7.0 || ^8.0",
        "symfony/config": "^7.0 || ^8.0",
        "symfony/security-core": "^7.0 || ^8.0",
        "symfony/uid": "^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "AlexandreBulete\\DddSymfonyBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlexandreBulete\\DddSymfonyBundle\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "doctrine/doctrine-bundle": "^2.13 || ^3.0",
        "doctrine/orm": "^3.3",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.0",
        "symfony/form": "^7.0 || ^8.0",
        "symfony/security-bundle": "^7.0 || ^8.0"
    },
    "suggest": {
        "symfony/form": "For the AutocompleteType and MarkdownType form types"
    },
    "scripts": {
        "phpstan": "phpstan analyse --no-progress",
        "test": "phpunit",
        "qa": [
            "@phpstan",
            "@test"
        ]
    }
}
