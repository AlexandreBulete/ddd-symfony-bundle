{
    "private": true,
    "description": "Builds assets/dist/markdown-editor.{js,css} (Milkdown Crepe), committed: applications need no Node build.",
    "scripts": {
        "build:milkdown": "esbuild assets/milkdown/milkdown-editor.entry.js --bundle --format=esm --minify --legal-comments=linked --outdir=assets/dist --entry-names=markdown-editor --loader:.svg=dataurl"
    },
    "devDependencies": {
        "@milkdown/crepe": "^7.23.0",
        "@milkdown/kit": "^7.23.0",
        "esbuild": "^0.25.12"
    }
}
